# Build artifacts (binaries are not committed)
/build/*
!/build/m0/
/build/m0/bin/
/build/m0/logs/
src/*/target/
src/*/*/target/
src/m0/*/target/
target/
**/target/

# Generated profiles may name a live endpoint — never commit them
profiles/**
!profiles/m0/
profiles/m0/**
!profiles/m0/.gitkeep

# Test run logs / lab artifacts (may contain generated test keys)
tests/m0/tmp/
tests/tmp/
src/go/tests/tmp/
*.log

# v2 release artifacts
/dist/

# Upstream reference copy (do not commit)
/awesomeC2-main/
/awesomeC2-main.zip

# Local editor / OS noise
.vscode/
.idea/
Thumbs.db
.DS_Store

# Runtime state / databases (may contain lab keys or session data)
*.db
*.db-journal
*.db-wal
*.db-shm

# Local handoff docs (HANDOFF.md contains credentials)
/HANDOFF.md
/AGENTS.md

# Never commit secrets
*.psk
secrets/
creds.json
